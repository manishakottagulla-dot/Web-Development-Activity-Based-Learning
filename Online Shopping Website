<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEase - Online Shopping</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f7fb;
            color: #333;
            line-height: 1.6;
        }

        /* Header and navigation */
        header {
            background-color: #173b65;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        header h1 {
            font-size: 28px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        /* Welcome banner */
        .hero {
            background: linear-gradient(
                rgba(0, 0, 0, 0.55),
                rgba(0, 0, 0, 0.55)
            ),
            url("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1400&q=80")
            center/cover no-repeat;

            min-height: 330px;
            padding: 80px 20px;
            text-align: center;
            color: white;
        }

        .hero h2 {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background-color: #ffb703;
            color: #173b65;
            padding: 12px 24px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover {
            background-color: #ffd166;
        }

        /* Categories */
        .categories {
            padding: 35px 7%;
            text-align: center;
        }

        .categories h2,
        .products h2,
        .about h2,
        .contact h2 {
            color: #173b65;
            font-size: 29px;
            margin-bottom: 22px;
        }

        .category-list {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .category {
            background-color: white;
            padding: 14px 24px;
            border-radius: 8px;
            box-shadow: 0 3px 10px #00000012;
            font-weight: bold;
        }

        /* Product section */
        .products {
            padding: 40px 7%;
            text-align: center;
        }

        .product-list {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 24px;
        }

        .product {
            width: 250px;
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 12px #00000015;
            transition: transform 0.3s;
            position: relative;
        }

        .product:hover {
            transform: translateY(-6px);
        }

        .product img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

        .product h3 {
            color: #173b65;
            margin: 12px 8px 5px;
        }

        .product p {
            margin: 5px 10px;
        }

        .rating {
            color: #e6a000;
        }

        .price {
            color: #16804a;
            font-size: 18px;
            font-weight: bold;
        }

        .old-price {
            color: #888;
            text-decoration: line-through;
            font-size: 14px;
            margin-left: 5px;
        }

        .offer {
            display: inline-block;
            background-color: #e63946;
            color: white;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 12px;
            margin: 10px 0;
        }

        .buy-btn {
            display: inline-block;
            background-color: #173b65;
            color: white;
            text-decoration: none;
            padding: 9px 18px;
            border-radius: 5px;
            margin: 10px 0 18px;
        }

        .buy-btn:hover {
            background-color: #28598c;
        }

        /* About section */
        .about {
            background-color: #e6eff8;
            padding: 45px 12%;
            text-align: center;
        }

        .about p {
            max-width: 750px;
            margin: auto;
        }

        /* Contact section */
        .contact {
            padding: 40px 20px;
            text-align: center;
            background-color: white;
        }

        .contact p {
            margin: 8px;
        }

        /* Footer */
        footer {
            background-color: #173b65;
            color: white;
            text-align: center;
            padding: 18px;
        }

        /* Mobile-friendly layout */
        @media (max-width: 600px) {
            header {
                justify-content: center;
                text-align: center;
            }

            nav {
                text-align: center;
            }

            nav a {
                display: inline-block;
                margin: 5px 7px;
            }

            .hero h2 {
                font-size: 30px;
            }

            .products,
            .categories {
                padding: 30px 5%;
            }

            .product {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>ShopEase</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#categories">Categories</a>
            <a href="#products">Products</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- Main banner -->
    <section class="hero" id="home">
        <h2>Welcome to ShopEase</h2>
        <p>Discover amazing products at affordable prices!</p>
        <a href="#products" class="btn">Explore Products</a>
    </section>

    <!-- Product categories -->
    <section class="categories" id="categories">
        <h2>Shop by Category</h2>

        <div class="category-list">
            <div class="category">👕 Fashion</div>
            <div class="category">🎧 Electronics</div>
            <div class="category">⌚ Accessories</div>
            <div class="category">👟 Footwear</div>
        </div>
    </section>

    <!-- Products -->
    <section class="products" id="products">
        <h2>Popular Products</h2>

        <div class="product-list">

            <div class="product">
                <img
                    src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80"
                    alt="Stylish wristwatch">

                <span class="offer">20% OFF</span>
                <h3>Classic Watch</h3>
                <p class="rating">★★★★★</p>
                <p class="price">
                    ₹1,599 <span class="old-price">₹1,999</span>
                </p>
                <a href="#contact" class="buy-btn">Buy Now</a>
            </div>

            <div class="product">
                <img
                    src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80"
                    alt="Wireless headphones">

                <span class="offer">15% OFF</span>
                <h3>Headphones</h3>
                <p class="rating">★★★★★</p>
                <p class="price">
                    ₹1,699 <span class="old-price">₹1,999</span>
                </p>
                <a href="#contact" class="buy-btn">Buy Now</a>
            </div>

            <div class="product">
                <img
                    src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80"
                    alt="Red sports shoes">

                <span class="offer">25% OFF</span>
                <h3>Sports Shoes</h3>
                <p class="rating">★★★★☆</p>
                <p class="price">
                    ₹2,249 <span class="old-price">₹2,999</span>
                </p>
                <a href="#contact" class="buy-btn">Buy Now</a>
            </div>

            <div class="product">
                <img
                    src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=600&q=80"
                    alt="Casual cotton T-shirt">

                <span class="offer">10% OFF</span>
                <h3>Cotton T-Shirt</h3>
                <p class="rating">★★★★☆</p>
                <p class="price">
                    ₹449 <span class="old-price">₹499</span>
                </p>
                <a href="#contact" class="buy-btn">Buy Now</a>
            </div>

        </div>
    </section>

    <!-- About us -->
    <section class="about" id="about">
        <h2>About ShopEase</h2>

        <p>
            ShopEase is a sample online shopping website designed to
            display a variety of products in one place. Customers can
            explore product categories, view prices and discounts,
            and learn about available products. Our aim is to make
            shopping information simple and easy to understand.
        </p>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <p>Email: shopease@example.com</p>
        <p>Phone: +91 98765 43210</p>
        <p>Location: Vijayawada, Andhra Pradesh</p>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 ShopEase. All rights reserved.</p>
    </footer>

</body>
</html>
