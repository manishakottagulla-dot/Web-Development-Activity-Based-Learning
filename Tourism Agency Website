<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dream Travels</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            color: #333;
            line-height: 1.6;
        }

        /* Navigation bar */
        header {
            background-color: #123b5d;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        header h1 {
            font-size: 27px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        /* Main banner */
        .hero {
            background: linear-gradient(
                rgba(0, 0, 0, 0.55),
                rgba(0, 0, 0, 0.55)
            ), url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b")
            center/cover no-repeat;

            min-height: 350px;
            padding: 90px 20px;
            text-align: center;
            color: white;
        }

        .hero h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background-color: #ffb703;
            color: #123b5d;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        .btn:hover {
            background-color: #ffd166;
        }

        /* Destinations */
        .destinations {
            padding: 45px 7%;
            text-align: center;
        }

        .destinations h2,
        .about h2,
        .contact h2 {
            color: #123b5d;
            font-size: 30px;
            margin-bottom: 25px;
        }

        .cards {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            background-color: white;
            width: 280px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 12px #00000020;
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-7px);
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .card h3 {
            color: #123b5d;
            margin: 12px;
        }

        .card p {
            padding: 0 12px;
            margin-bottom: 12px;
        }

        .price {
            color: #16804a;
            font-weight: bold;
        }

        /* About section */
        .about {
            background-color: #e2edf6;
            padding: 45px 12%;
            text-align: center;
        }

        .about p {
            max-width: 750px;
            margin: auto;
        }

        /* Contact section */
        .contact {
            padding: 40px 20px;
            text-align: center;
            background-color: white;
        }

        .contact p {
            margin: 8px;
        }

        /* Footer */
        footer {
            background-color: #123b5d;
            color: white;
            padding: 18px;
            text-align: center;
        }

        /* Mobile screen design */
        @media (max-width: 600px) {
            header {
                justify-content: center;
                gap: 12px;
            }

            nav {
                text-align: center;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }

            .hero h2 {
                font-size: 30px;
            }

            .destinations {
                padding: 30px 5%;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Dream Travels</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#destinations">Destinations</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <section class="hero" id="home">
        <h2>Explore the World with Us</h2>
        <p>Discover beautiful places and create unforgettable memories.</p>
        <a href="#destinations" class="btn">Explore Destinations</a>
    </section>

    <section class="destinations" id="destinations">
        <h2>Popular Destinations</h2>

        <div class="cards">

            <div class="card">
                <img
                    src="https://images.unsplash.com/photo-1564507592333-c60657eea523?auto=format&fit=crop&w=600&q=80"
                    alt="Taj Mahal in Agra">

                <h3>Agra</h3>
                <p>Visit the beautiful Taj Mahal, a symbol of love.</p>
                <p class="price">Starting from ₹4,999</p>
            </div>

            <div class="card">
                <img
                    src="https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=600&q=80"
                    alt="Palace in Jaipur">

                <h3>Jaipur</h3>
                <p>Explore royal palaces and colourful markets.</p>
                <p class="price">Starting from ₹5,999</p>
            </div>

            <div class="card">
                <img
                    src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=600&q=80"
                    alt="Beautiful Kerala landscape">

                <h3>Kerala</h3>
                <p>Enjoy peaceful backwaters and green landscapes.</p>
                <p class="price">Starting from ₹6,999</p>
            </div>

        </div>
    </section>

    <section class="about" id="about">
        <h2>About Dream Travels</h2>

        <p>
            Dream Travels helps people discover amazing destinations.
            We provide travel information, tour packages and memorable
            holiday experiences for families and friends.
            Our goal is to make every journey comfortable and enjoyable.
        </p>
    </section>

    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <p>Email: dreamtravels@example.com</p>
        <p>Phone: +91 98765 43210</p>
        <p>Location: Vijayawada, Andhra Pradesh</p>
    </section>

    <footer>
        <p>&copy; 2026 Dream Travels. All rights reserved.</p>
    </footer>

</body>
</html>
